# Docker Compose environment
# Copy to .env.docker.local and configure the Supabase/OpenAI values.

# PostgreSQL container
DB_USER=swimuser
DB_PASSWORD=swimpass
DB_NAME=swim_db
# Optional host-side connection string for Prisma commands.
DATABASE_URL=postgresql://swimuser:swimpass@localhost:5432/swim_db

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_SESSION_PHOTOS_BUCKET=session-photos

# API and AI services
FRONTEND_URL=http://localhost:3000
AI_SERVICE_TOKEN=
AI_MODE=mock
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Runtime
NODE_ENV=development
ENVIRONMENT=development
