# Docker Compose Environment Configuration
# Copy this file to .env.docker.local and configure for your environment

# Database Configuration
DB_USER=swimuser
DB_PASSWORD=swimpass
DB_NAME=swim_db
# Optional direct connection string for running Prisma from the host
DATABASE_URL=postgresql://swimuser:swimpass@localhost:5432/swim_db

# Supabase Authentication (Required - get from supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Node Environment
NODE_ENV=development

# Python Environment
ENVIRONMENT=development
