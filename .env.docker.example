# Docker Compose Environment Configuration
# Copy this file to .env.docker.local and configure for your environment

# Database Configuration
DB_USER=swimuser
DB_PASSWORD=swimpass
DB_NAME=swim_db
# Optional direct connection string for running Prisma from the host
DATABASE_URL=postgresql://swimuser:swimpass@localhost:5432/swim_db

# Clerk Authentication (Required - get from clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Node Environment
NODE_ENV=development

# Python Environment
ENVIRONMENT=development
