# Server-only database connection. Never expose this to the browser.
DATABASE_URL=postgresql://localhost:5432/swim_db

# Browser-safe Supabase Auth settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Use the publishable key instead of the anon key when your project provides it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase settings used by the API and private Storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SESSION_PHOTOS_BUCKET=session-photos

# Web and API routing.
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
PORT=3001
FRONTEND_URL=http://localhost:3000

# API-to-AI service authentication.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=

# AI provider configuration. Use mock mode locally; OpenAI keys stay server-side.
AI_MODE=mock
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Runtime and safe structured log verbosity.
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info
