generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  PENDING
  COMPLETED
  MISSED
}

enum SessionWorkflowStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  ARCHIVED
}

enum AthleteResultStatus {
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum ClubRole {
  OWNER
  COACH
  ATHLETE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum ClubStatus {
  ACTIVE
  ARCHIVED
}

enum AiReportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  STALE
}

enum AiReportType {
  SESSION
  ATHLETE
  COACH
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  authId              String            @unique
  email               String            @unique
  name                String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  coach               Coach?
  athlete             Athlete?
  ownedClubs          Club[]            @relation("ClubOwner")
  clubMemberships     ClubMembership[]
  sentInvitations     Invitation[]      @relation("InvitationSender")
  acceptedInvitations Invitation[]      @relation("InvitationAccepter")
  squadMemberships    SquadMembership[]
  coachedSessions     Session[]         @relation("SessionCoach")
  athleteResults      AthleteResult[]   @relation("AthleteResultUser")
  aiReports           AiReport[]        @relation("AiReportAthlete")
}

model Club {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  ownerId     String           @db.Uuid
  status      ClubStatus       @default(ACTIVE)
  owner       User             @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships ClubMembership[]
  invitations Invitation[]
  squads      Squad[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  Session     Session[]

  @@index([ownerId])
  @@index([status])
}

model ClubMembership {
  id        String           @id @default(uuid()) @db.Uuid
  clubId    String           @db.Uuid
  userId    String           @db.Uuid
  role      ClubRole
  status    MembershipStatus @default(ACTIVE)
  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([clubId, userId])
  @@index([userId, status])
  @@index([clubId, role, status])
}

model Invitation {
  id           String           @id @default(uuid()) @db.Uuid
  clubId       String           @db.Uuid
  email        String
  role         ClubRole
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String           @db.Uuid
  acceptedById String?          @db.Uuid
  club         Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?            @relation("InvitationAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clubId, status])
  @@index([email, status])
  @@index([expiresAt])
}

model Squad {
  id          String            @id @default(uuid()) @db.Uuid
  clubId      String            @db.Uuid
  name        String
  description String?
  isActive    Boolean           @default(true)
  club        Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberships SquadMembership[]
  sessions    Session[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([clubId, name])
  @@index([clubId, isActive])
}

model SquadMembership {
  id        String   @id @default(uuid()) @db.Uuid
  squadId   String   @db.Uuid
  userId    String   @db.Uuid
  squad     Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([squadId, userId])
  @@index([userId])
}

model Coach {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  bio            String?
  specialization String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams          Team[]
  athletes       Athlete[]
  workouts       Workout[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Athlete {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  coachId        String    @db.Uuid
  teamId         String?   @db.Uuid
  ageGroup       String?
  primaryStrokes String[]  @default([])
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach          Coach     @relation(fields: [coachId], references: [id], onDelete: Restrict)
  team           Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sessions       Session[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([coachId])
  @@index([teamId])
}

model Team {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  coachId     String    @db.Uuid
  description String?
  coach       Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athletes    Athlete[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([coachId])
}

model Workout {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?
  coachId     String       @db.Uuid
  isTemplate  Boolean      @default(false)
  templateId  String?      @db.Uuid
  coach       Coach        @relation(fields: [coachId], references: [id], onDelete: Cascade)
  template    Workout?     @relation("WorkoutTemplates", fields: [templateId], references: [id], onDelete: SetNull)
  variations  Workout[]    @relation("WorkoutTemplates")
  sets        WorkoutSet[]
  sessions    Session[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([coachId])
  @@index([templateId])
}

model WorkoutSet {
  id        String  @id @default(uuid()) @db.Uuid
  workoutId String  @db.Uuid
  position  Int
  reps      Int
  distance  Int?
  time      Int?
  stroke    String?
  pace      String?
  notes     String?
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([workoutId, position])
}

model Session {
  id             String                @id @default(uuid()) @db.Uuid
  workoutId      String?               @db.Uuid
  athleteId      String?               @db.Uuid
  clubId         String?               @db.Uuid
  squadId        String?               @db.Uuid
  coachId        String?               @db.Uuid
  title          String?
  sessionType    String?
  scheduledDate  DateTime
  completedDate  DateTime?
  publishedAt    DateTime?
  status         SessionStatus         @default(PENDING)
  workflowStatus SessionWorkflowStatus @default(DRAFT)
  notes          String?
  workout        Workout?              @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  athlete        Athlete?              @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  club           Club?                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  squad          Squad?                @relation(fields: [squadId], references: [id], onDelete: Cascade)
  coach          User?                 @relation("SessionCoach", fields: [coachId], references: [id], onDelete: Restrict)
  photo          SessionPhoto?
  mainSets       MainSet[]
  results        AthleteResult[]
  aiReports      AiReport[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([athleteId, scheduledDate])
  @@index([workoutId])
  @@index([clubId, scheduledDate])
  @@index([squadId, scheduledDate, workflowStatus])
  @@index([coachId, scheduledDate])
  @@map("sessions")
}

model SessionPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @unique @db.Uuid
  storagePath String
  contentType String
  sizeBytes   Int
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("session_photos")
}

model MainSet {
  id             String      @id @default(uuid()) @db.Uuid
  sessionId      String      @db.Uuid
  position       Int
  stroke         String?
  distanceMeters Int?
  repetitions    Int
  sendOffSeconds Int?
  notes          String?
  session        Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  repResults     RepResult[]

  @@unique([sessionId, position])
  @@index([sessionId])
  @@map("main_sets")
}

model AthleteResult {
  id          String              @id @default(uuid()) @db.Uuid
  sessionId   String              @db.Uuid
  userId      String              @db.Uuid
  status      AthleteResultStatus @default(IN_PROGRESS)
  startedAt   DateTime            @default(now())
  completedAt DateTime?
  session     Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User                @relation("AthleteResultUser", fields: [userId], references: [id], onDelete: Cascade)
  repResults  RepResult[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([sessionId, userId])
  @@index([userId, completedAt])
  @@map("athlete_results")
}

model RepResult {
  id              String        @id @default(uuid()) @db.Uuid
  athleteResultId String        @db.Uuid
  mainSetId       String        @db.Uuid
  repNumber       Int
  timeMs          Int
  notes           String?
  athleteResult   AthleteResult @relation(fields: [athleteResultId], references: [id], onDelete: Cascade)
  mainSet         MainSet       @relation(fields: [mainSetId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([athleteResultId, mainSetId, repNumber])
  @@index([mainSetId])
  @@map("rep_results")
}

model AiReport {
  id               String         @id @default(uuid()) @db.Uuid
  sessionId        String         @db.Uuid
  athleteId        String?        @db.Uuid
  reportType       AiReportType
  status           AiReportStatus @default(QUEUED)
  promptVersion    String
  model            String?
  inputSummaryHash String
  result           Json?
  renderedSummary  String?
  errorCode        String?
  retryCount       Int            @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  session          Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete          User?          @relation("AiReportAthlete", fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([sessionId, athleteId, reportType, inputSummaryHash])
  @@index([sessionId, reportType, status])
  @@index([athleteId, createdAt])
}
