generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  PENDING
  COMPLETED
  MISSED
}

enum ClubRole {
  OWNER
  COACH
  ATHLETE
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum ClubStatus {
  ACTIVE
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  authId              String            @unique
  email               String            @unique
  name                String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  coach               Coach?
  athlete             Athlete?
  ownedClubs          Club[]            @relation("ClubOwner")
  clubMemberships     ClubMembership[]
  sentInvitations     Invitation[]      @relation("InvitationSender")
  acceptedInvitations Invitation[]      @relation("InvitationAccepter")
  squadMemberships    SquadMembership[]
}

model Club {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  ownerId     String           @db.Uuid
  status      ClubStatus       @default(ACTIVE)
  owner       User             @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships ClubMembership[]
  invitations Invitation[]
  squads      Squad[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([ownerId])
  @@index([status])
}

model ClubMembership {
  id        String           @id @default(uuid()) @db.Uuid
  clubId    String           @db.Uuid
  userId    String           @db.Uuid
  role      ClubRole
  status    MembershipStatus @default(ACTIVE)
  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([clubId, userId])
  @@index([userId, status])
  @@index([clubId, role, status])
}

model Invitation {
  id           String           @id @default(uuid()) @db.Uuid
  clubId       String           @db.Uuid
  email        String
  role         ClubRole
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String           @db.Uuid
  acceptedById String?          @db.Uuid
  club         Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?            @relation("InvitationAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clubId, status])
  @@index([email, status])
  @@index([expiresAt])
}

model Squad {
  id          String            @id @default(uuid()) @db.Uuid
  clubId      String            @db.Uuid
  name        String
  description String?
  isActive    Boolean           @default(true)
  club        Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberships SquadMembership[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([clubId, name])
  @@index([clubId, isActive])
}

model SquadMembership {
  id        String   @id @default(uuid()) @db.Uuid
  squadId   String   @db.Uuid
  userId    String   @db.Uuid
  squad     Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([squadId, userId])
  @@index([userId])
}

model Coach {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  bio            String?
  specialization String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams          Team[]
  athletes       Athlete[]
  workouts       Workout[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Athlete {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  coachId        String    @db.Uuid
  teamId         String?   @db.Uuid
  ageGroup       String?
  primaryStrokes String[]  @default([])
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach          Coach     @relation(fields: [coachId], references: [id], onDelete: Restrict)
  team           Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sessions       Session[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([coachId])
  @@index([teamId])
}

model Team {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  coachId     String    @db.Uuid
  description String?
  coach       Coach     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athletes    Athlete[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([coachId])
}

model Workout {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?
  coachId     String       @db.Uuid
  isTemplate  Boolean      @default(false)
  templateId  String?      @db.Uuid
  coach       Coach        @relation(fields: [coachId], references: [id], onDelete: Cascade)
  template    Workout?     @relation("WorkoutTemplates", fields: [templateId], references: [id], onDelete: SetNull)
  variations  Workout[]    @relation("WorkoutTemplates")
  sets        WorkoutSet[]
  sessions    Session[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([coachId])
  @@index([templateId])
}

model WorkoutSet {
  id        String  @id @default(uuid()) @db.Uuid
  workoutId String  @db.Uuid
  position  Int
  reps      Int
  distance  Int?
  time      Int?
  stroke    String?
  pace      String?
  notes     String?
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([workoutId, position])
}

model Session {
  id            String        @id @default(uuid()) @db.Uuid
  workoutId     String        @db.Uuid
  athleteId     String        @db.Uuid
  scheduledDate DateTime
  completedDate DateTime?
  status        SessionStatus @default(PENDING)
  notes         String?
  workout       Workout       @relation(fields: [workoutId], references: [id], onDelete: Restrict)
  athlete       Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([athleteId, scheduledDate])
  @@index([workoutId])
}
